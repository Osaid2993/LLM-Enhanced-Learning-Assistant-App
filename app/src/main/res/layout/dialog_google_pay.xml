<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/white"
    android:orientation="vertical"
    android:padding="24dp">

    <ImageView
        android:layout_width="80dp"
        android:layout_height="36dp"
        android:src="@drawable/ic_google_pay"
        android:contentDescription="Google Pay"
        android:layout_gravity="center"
        android:layout_marginBottom="20dp" />

    <TextView
        android:id="@+id/payTierName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Starter Plan"
        android:textColor="#333333"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_gravity="center" />

    <TextView
        android:id="@+id/payAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="$2.99"
        android:textColor="#666666"
        android:textSize="15sp"
        android:layout_gravity="center"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="20dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Payment Method"
        android:textColor="#999999"
        android:textSize="12sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Visa •••• 4242"
        android:textColor="#333333"
        android:textSize="14sp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="20dp" />

    <Button
        android:id="@+id/confirmPayButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_button_gpay"
        android:text="Pay"
        android:textColor="@android:color/white"
        android:textSize="15sp"
        android:textAllCaps="false"
        app:backgroundTint="@null" />

    <Button
        android:id="@+id/cancelPayButton"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@android:color/transparent"
        android:text="Cancel"
        android:textColor="#999999"
        android:textSize="14sp"
        android:textAllCaps="false"
        android:layout_marginTop="4dp" />

</LinearLayout>